# Cleanverse sandbox
CLEANVERSE_API_BASE_URL=
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# Backend
NODE_ENV=development
PORT=3000
API_CORS_ORIGIN=http://localhost:5173

# Monad testnet
MONAD_RPC_URL=
MONAD_CHAIN_ID=
DEPLOYER_PRIVATE_KEY=

# Public Vite web configuration
# Never place Cleanverse credentials or private keys in VITE_ variables.
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
VITE_MONAD_RPC_URL=
VITE_MONAD_CHAIN_ID=
VITE_MONAD_EXPLORER_URL=

# Optional deterministic demo mode
DEMO_MODE=false
