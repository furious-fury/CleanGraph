# Cleanverse sandbox
CLEANVERSE_BASE_URL=
CLEANVERSE_TIMEOUT_MS=10000
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# Backend
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# Required for protected operator routes; use at least 32 characters.
OPERATOR_TOKEN=
# TRWA token address and country allowlist are required together after testnet deployment.
TRWA_TOKEN_ADDRESS=
# Optional exact, case-sensitive two-character provider codes; leave blank to disable each check.
TRWA_ALLOWED_GROUP=
TRWA_ALLOWED_SUBGROUP=
# Example after deployment: US,GB,DE,SG
TRWA_ALLOWED_COUNTRIES=

# Monad testnet
MONAD_RPC_URL=
MONAD_CHAIN_ID=
MONAD_EXPLORER_URL=
DEPLOYER_PRIVATE_KEY=
TRWA_TREASURY_ADDRESS=

# Public Vite web configuration
# Never place Cleanverse credentials or private keys in VITE_ variables.
VITE_API_BASE_URL=http://localhost:3000
VITE_MONAD_RPC_URL=
VITE_MONAD_CHAIN_ID=
VITE_MONAD_EXPLORER_URL=
# Public Privy application ID. Leave blank to disable external wallet connections.
VITE_PRIVY_APP_ID=

# Fictional UAT A-Pass onboarding. Keep disabled outside the hackathon demo.
DEMO_MODE=false
# Required only when DEMO_MODE=true.
DATABASE_URL=
# Trust only a header set by a proxy that strips user-supplied copies.
DEMO_CLIENT_IP_HEADER=X-Forwarded-For
