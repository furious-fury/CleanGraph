{
  "name": "@cleangraph/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "TMPDIR=/tmp tsx watch src/index.ts",
    "lint": "oxlint src tests",
    "pretest": "pnpm --filter @cleangraph/shared build && pnpm --filter @cleangraph/cleanverse-client build",
    "db:migrate": "tsx src/commands/migrate.ts",
    "purge:demo-apass": "tsx src/commands/purge-demo-apass.ts",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test TMPDIR=/tmp vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cleangraph/cleanverse-client": "workspace:*",
    "@cleangraph/shared": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.32",
    "pg": "8.16.3",
    "viem": "2.37.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.15.5",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
